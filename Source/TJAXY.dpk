package TJAXY;

{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl;

contains
  TJAXY.Core in 'TJAXY.Core.pas',
  TJAXY.TOML in 'TJAXY.TOML.pas',
  TJAXY.JSON in 'TJAXY.JSON.pas',
  TJAXY.Avro in 'TJAXY.Avro.pas',
  TJAXY.XML in 'TJAXY.XML.pas',
  TJAXY.YAML in 'TJAXY.YAML.pas';

end.
